---
import { getRelativeLocaleUrl } from 'astro:i18n';

const { title = 'AdaptiveCAD', description = 'A curvature-first CAD/CAM system built on Adaptive Pi geometry', meta = [] } = Astro.props;
const fullTitle = title === 'AdaptiveCAD' ? title : `${title} • AdaptiveCAD`;

// Helper to create proper base paths
const basePath = import.meta.env.BASE_URL || '/';
const assetPath = (path: string) => {
  const cleanPath = path.replace(/^\//, '');
  return basePath.endsWith('/') ? basePath + cleanPath : basePath + '/' + cleanPath;
};
const linkPath = (path: string) => basePath.replace(/\/$/, '') + path;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
  {meta.map(m => <meta {...m} />)}
  <link rel="stylesheet" href={assetPath('fonts.css')} />
  <link rel="stylesheet" href={assetPath('global.css')} />
</head>
<body>
  <header class="site-header">
    <div class="container">
      <nav class="main-nav">
        <a href={linkPath('/')} class="brand">AdaptiveCAD</a>
        <div class="nav-links">
          <a href={linkPath('/concept')}>Concept</a>
            <a href={linkPath('/research')}>Research</a>
          <a href={linkPath('/blog')}>Blog</a>
          <a href="https://github.com/RDM3DC/AdaptiveCAD" target="_blank" rel="noopener">GitHub</a>
        </div>
      </nav>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer>
    <p>&copy; {new Date().getFullYear()} AdaptiveCAD. All rights reserved.</p>
  </footer>
</body>
</html>